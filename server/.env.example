# Documentation: docs/environment.md and docs/atlas-network-access.md

PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas user password (Database Access in Atlas console)
MONGODB_URI=mongodb+srv://baktiergalib_db_user:YOUR_PASSWORD@eldercare.k5gr66j.mongodb.net/eldercare?retryWrites=true&w=majority&appName=eldercare

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Required when registering an admin account through /auth/register
ADMIN_INVITE_CODE=eldercare-admin-dev

# ImgBB (https://api.imgbb.com/1/upload)
IMGBB_API_KEY=your_imgbb_api_key

# 100ms (https://dashboard.100ms.live/developer)
HMS_ACCESS_KEY=your_100ms_app_access_key
HMS_APP_SECRET=your_100ms_app_secret
# Optional: override default template / role names from your 100ms dashboard
# Default ElderCare template is medcoord (roles: doctor, patient)
HMS_TEMPLATE_ID=698c59eb970f62489e2aa9a1
HMS_ROLE_DOCTOR=doctor
HMS_ROLE_CAREGIVER=patient
# Optional webhook receiver for 100ms events
# HMS_WEBHOOK_URL=
